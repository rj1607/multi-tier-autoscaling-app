# ==========================================
# Flask Configuration
# ==========================================

FLASK_APP=app.py
FLASK_ENV=production

# ==========================================
# Application
# ==========================================

APP_HOST=0.0.0.0
APP_PORT=5000

# ==========================================
# Amazon RDS
# ==========================================

DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-rds-password
DB_NAME=autoscaling_app